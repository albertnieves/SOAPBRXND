# Copia a .env.local (nunca al repo). Sin las de Supabase, la tienda arranca en modo demo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: crea pedidos y confirma pagos
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel la manda en «Authorization: Bearer …» al llamar al cron
CRON_SECRET=
